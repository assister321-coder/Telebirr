<?xml version="1.0" encoding="UTF-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/spacing_sm"
    android:background="?attr/selectableItemBackground">

    <View
        android:id="@+id/iconBg"
        android:layout_width="@dimen/service_icon_size"
        android:layout_height="@dimen/service_icon_size"
        android:background="@drawable/bg_service_icon" />

    <TextView
        android:id="@+id/iconView"
        android:layout_width="@dimen/icon_service"
        android:layout_height="@dimen/icon_service"
        android:layout_gravity="center"
        android:textSize="@dimen/icon_service"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/icon_service"
        android:layout_height="@dimen/icon_service"
        android:layout_gravity="center"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/tvServiceName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_sm"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="@dimen/spacing_xs" />
</LinearLayout>
