<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <style name="Theme.Telebirr" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_secondary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Telebirr.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_hero</item>
        <item name="android:statusBarColor">@color/bg_hero</item>
        <item name="android:navigationBarColor">@color/bg_hero</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Common styles -->
    <style name="TelebirrButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TelebirrButton.Secondary">
        <item name="backgroundTint">@color/soft_bg</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TelebirrCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <style name="TelebirrInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/divider</item>
        <item name="hintTextColor">@color/brand_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="TelebirrChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">@dimen/radius_full</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="chipBackgroundColor">@color/soft_bg</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>
